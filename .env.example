# --- Cloudflare: capture deployment ---

# API token wrangler uses to deploy the Worker `bikesharing-capture` (capture/).
# Account-owned token `bikesharing-capture-deploy`, Workers Editor role on the
# account's Workers, one-year expiry (docs/decisions/0038-account-wide-workers-editor-deploy-token.md).
CLOUDFLARE_API_TOKEN=

# --- Cloudflare R2: bronze read access ---

# Access key pair of the R2 token `bikesharing-owner-bronze-read`, read-only on
# `bikesharing-bronze`, for the owner's local reads of bronze (listings, downloads
# and probes). It is the pair of R2's S3 API, not the token value the dashboard shows.
BRONZE_R2_ACCESS_KEY_ID=
BRONZE_R2_SECRET_ACCESS_KEY=

LAKEHOUSE_READ_R2_ACCESS_KEY_ID=
LAKEHOUSE_READ_R2_SECRET_ACCESS_KEY=

# --- Grafana Cloud: monitoring configuration (monitoring/) ---

# Terraform variables for Grafana's provider (docs/decisions/0051-monitoring-configuration-as-code.md).
# The stack's URL, for alerting and IRM; not secret.
TF_VAR_grafana_url=
# Token of the stack service account `terraform`, for alerting and IRM; needs `plugins.app:access`.
TF_VAR_grafana_auth=
# Synthetic Monitoring access token and the stack's Synthetic Monitoring API URL, for ALR4's check.
TF_VAR_grafana_sm_access_token=
TF_VAR_grafana_sm_url=
# Signal URL of the watchdog's check in Healthchecks.io (docs/sources/healthchecks-io.md).
TF_VAR_watchdog_url=
# UIDs of the stack's data sources (docs/sources/grafana-cloud.md › Access); not secret.
TF_VAR_loki_datasource_uid=
TF_VAR_prometheus_datasource_uid=
TF_VAR_usage_datasource_uid=
# Base URL of the page served by web/, with no trailing slash, read by ALR4's check.
TF_VAR_page_base_url=
# Username of the owner's Grafana user (Administration › Users), whom the pages' IRM escalation chain notifies.
TF_VAR_irm_owner_username=

# --- Open Data BCN ---

# Token for the Open Data BCN secured JSON resources of Bicing, a fallback source,
# sent in the `Authorization` header (docs/sources/bicing.md).
# Not needed while the operator feed works.
OPEN_DATA_BCN_TOKEN=
