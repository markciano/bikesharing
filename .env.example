# --- Cloudflare: capture deployment ---

# API token wrangler uses to deploy the Worker `bikesharing-capture` (capture/).
# Account-owned token `bikesharing-capture-deploy`, Workers Editor role on the
# account's Workers, one-year expiry (docs/decisions/0038-account-wide-workers-editor-deploy-token.md).
CLOUDFLARE_API_TOKEN=

# --- Cloudflare R2: bronze read access ---

# Access key pair of the R2 token `bikesharing-owner-bronze-read`, read-only on
# `bikesharing-bronze`, for the owner's local reads of bronze (listings, downloads
# and probes). It is the pair of R2's S3 API, not the token value the dashboard shows.
BRONZE_R2_ACCESS_KEY_ID=
BRONZE_R2_SECRET_ACCESS_KEY=

LAKEHOUSE_READ_R2_ACCESS_KEY_ID=
LAKEHOUSE_READ_R2_SECRET_ACCESS_KEY=

# --- Open Data BCN ---

# Token for the Open Data BCN secured JSON resources of Bicing, a fallback source,
# sent in the `Authorization` header (docs/sources/bicing.md).
# Not needed while the operator feed works.
OPEN_DATA_BCN_TOKEN=
