# --- Cloudflare: capture deployment ---

# API token wrangler uses to deploy the Worker `bikesharing-capture` (capture/).
# Account-owned token, Editor on that Worker only, one-year expiry
# (docs/designs/d004-bronze-data-capture.md, Deployment).
CLOUDFLARE_API_TOKEN=

# --- Cloudflare R2: S3 API access ---

# Access key pair for scripts that read or write R2 through its S3 API.
# TODO(T039): set the scripts that use it and the token's scope (buckets, read or write).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# S3 endpoint of the account: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=

# --- Open Data BCN ---

# Token for the Open Data BCN secured JSON resources of Bicing, a fallback source,
# sent in the `Authorization` header (docs/sources/bicing.md).
# Not needed while the operator feed works.
OPEN_DATA_BCN_TOKEN=
