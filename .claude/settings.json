{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": { "GIT_OPTIONAL_LOCKS": "0" },
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "blockReadsOutsideWorkingDirectories": true,
    "allow": [
      "Bash(gh issue list *)", "Bash(gh issue view *)",
      "Bash(gh pr list *)", "Bash(gh pr view *)", "Bash(gh pr checks *)",

      "Bash(git status)", "Bash(git status *)", "Bash(git diff)", "Bash(git diff *)",
      "Bash(git log)", "Bash(git log *)", "Bash(git show *)",
      "Bash(ls)", "Bash(ls *)",

      "Bash(npm test)", "Bash(npm test *)", "Bash(npx vitest run)", "Bash(npx vitest run *)"
    ],
    "ask": [
      "Edit(/.claude/**)",
      "Edit(/CLAUDE.md)",
      "Edit(/docs/decisions/**)",

      "Bash(gh issue create *)", "Bash(gh issue edit *)", "Bash(gh issue close *)"
    ],
    "deny": [
      "Read(.env)",
      "Edit(.env)",
      "Edit(**/raw/**)",

      "Bash(git add *)", "Bash(git commit *)", "Bash(git merge *)", "Bash(git rebase *)",
      "Bash(git cherry-pick *)", "Bash(git revert *)", "Bash(git tag *)",

      "Bash(git checkout *)", "Bash(git switch *)", "Bash(git restore *)", "Bash(git reset *)",
      "Bash(git stash *)", "Bash(git clean *)", "Bash(git rm *)", "Bash(git mv *)", "Bash(git branch *)",

      "Bash(git push *)", "Bash(git pull *)", "Bash(git fetch *)",

      "Bash(gh api *)", "Bash(gh pr merge *)", "Bash(gh repo delete *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/markdown-lint.sh" }]
      }
    ]
  }
}