{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": { "GIT_OPTIONAL_LOCKS": "0" },
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "blockReadsOutsideWorkingDirectories": true,
    "ask": [
      "Edit(/.claude/**)",
      "Edit(/CLAUDE.md)",
      "Edit(/docs/decisions/**)"
    ],
    "deny": [
      "Read(.env)",
      "Edit(.env)",
      "Edit(**/raw/**)",

      "Bash(git add *)", "Bash(git commit *)", "Bash(git merge *)", "Bash(git rebase *)",
      "Bash(git cherry-pick *)", "Bash(git revert *)", "Bash(git tag *)",

      "Bash(git checkout *)", "Bash(git switch *)", "Bash(git restore *)", "Bash(git reset *)",
      "Bash(git stash *)", "Bash(git clean *)", "Bash(git rm *)", "Bash(git mv *)", "Bash(git branch *)",

      "Bash(git push *)", "Bash(git pull *)", "Bash(git fetch *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/markdown-lint.sh" }]
      }
    ]
  }
}